---
import { ClientRouter } from "astro:transitions";
import type { I18nDictionary } from "@platform/types";
import { getDictionary, DEFAULT_LOCALE } from "@platform/content";
import Header from "../components/Header.astro";
import Contact from "../components/Contact.astro";
import Footer from "../components/Footer.astro";
import "../styles/global.css";

interface Props {
  dict?: I18nDictionary;
  title?: string;
  description?: string;
  showContact?: boolean;
  showFooter?: boolean;
}

const {
  dict = getDictionary(DEFAULT_LOCALE),
  title = dict.site.defaultTitle,
  description = dict.site.defaultDescription,
  showContact = true,
  showFooter = false
} = Astro.props;
---

<!doctype html>
<html lang={dict.locale} class="scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/brand/logo-js-favicon.svg" />
    <link rel="apple-touch-icon" href="/brand/logo-js-favicon.svg" />
    <link rel="manifest" href="/site.webmanifest" />
    <meta name="theme-color" content="#101210" />
    <meta name="generator" content={Astro.generator} />

    <!-- SEO Best Practices with dynamic non-hardcoded titles -->
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="robots" content="index, follow" />
    <link rel="canonical" href={Astro.url.href} />

    <!-- Open Graph / Social Sharing -->
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={Astro.url.href} />
    <meta property="og:image" content="/brand/og-image.svg" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content="/brand/og-image.svg" />

    <!-- Prevent Dark Mode Flicker and persist on page transitions -->
    <script is:inline>
      function applyTheme() {
        const savedTheme = localStorage.getItem("theme");
        const prefersDark = window.matchMedia("(prefers-color-scheme: dark)").matches;
        if (savedTheme === "dark" || (!savedTheme && prefersDark)) {
          document.documentElement.classList.add("dark");
        } else {
          document.documentElement.classList.remove("dark");
        }
      }
      applyTheme();
      document.addEventListener("astro:after-swap", applyTheme);
    </script>

    <!-- Astro View Transitions -->
    <ClientRouter />
  </head>
  <body class="min-h-screen bg-background dark:bg-dark text-ink dark:text-white selection:bg-primary selection:text-ink transition-colors duration-300">
    <Header dict={dict} />

    <main id="main-content" class="overflow-x-hidden">
      <slot />
    </main>

    <!-- Dennis Snellenberg Style Contact & Master Footer -->
    {showContact && dict.contact && (
      <Contact data={dict.contact} site={dict.site} />
    )}

    {showFooter && (
      <Footer data={dict.footer} site={dict.site} />
    )}

    <!-- Animation lifecycle bootstrap -->
    <script>
      import { initAllAnimations } from "../animations";

      // Execute on initial render
      initAllAnimations();
    </script>
  </body>
</html>

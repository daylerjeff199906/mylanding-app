---
import { ClientRouter } from "astro:transitions";
import type { I18nDictionary } from "@platform/types";
import { getDictionary, DEFAULT_LOCALE } from "@platform/content";
import Header from "../components/Header.astro";
import Contact from "../components/Contact.astro";
import Footer from "../components/Footer.astro";
import "../styles/global.css";

interface Props {
  dict?: I18nDictionary;
  title?: string;
  description?: string;
  image?: string;
  showContact?: boolean;
  showFooter?: boolean;
}

const {
  dict = getDictionary(DEFAULT_LOCALE),
  title = dict.site.defaultTitle,
  description = dict.site.defaultDescription,
  image = "/images/meta_identidad.png",
  showContact = true,
  showFooter = false
} = Astro.props;

const siteOrigin = "https://josesantos.site";
const canonicalURL = new URL(Astro.url.pathname, siteOrigin).href;
const ogImageURL = new URL(image, siteOrigin).href;
const isEn = dict.locale === "en";

// Schema.org Person & WebSite graph for Google authority and Knowledge Panel
const schemaJsonLd = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "Person",
      "@id": "https://josesantos.site/#person",
      "name": "JOSE JEFFERSON SANTOS",
      "givenName": "Jose Jefferson",
      "familyName": "Santos Panaifo",
      "additionalName": "daylerjeff",
      "alternateName": ["JEFF Santos", "daylerjeff", "daylerjeff199906", "Jose Jefferson Santos"],
      "url": "https://josesantos.site",
      "image": "https://josesantos.site/images/meta_identidad.png",
      "jobTitle": "Software Engineer & Frontend Architect",
      "description": "Ingeniero de Sistemas e Informática especializado en arquitectura frontend, diseño de sistemas y desarrollo de productos digitales.",
      "sameAs": [
        "https://www.linkedin.com/in/josé-jefferson-santos-panaifo-3668a7246",
        "https://github.com/daylerjeff",
        "https://github.com/daylerjeff199906",
        "https://www.tiktok.com/@daylerjeff"
      ],
      "knowsAbout": [
        "Software Engineering",
        "Frontend Architecture",
        "TypeScript",
        "React",
        "Next.js",
        "Astro",
        "UX/UI Design",
        "Healthcare Informatics",
        "Amazonian Biodiversity Informatics"
      ],
      "alumniOf": {
        "@type": "EducationalOrganization",
        "name": "Universidad Nacional de la Amazonía Peruana"
      }
    },
    {
      "@type": "WebSite",
      "@id": "https://josesantos.site/#website",
      "url": "https://josesantos.site",
      "name": "JOSE JEFFERSON SANTOS // Software Engineer (@daylerjeff)",
      "alternateName": "josesantos.site",
      "publisher": {
        "@id": "https://josesantos.site/#person"
      },
      "inLanguage": ["es", "en"]
    }
  ]
};
---

<!doctype html>
<html lang={dict.locale} class="scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/brand/logo-js-favicon.svg" />
    <link rel="apple-touch-icon" href="/brand/logo-js-favicon.svg" />
    <link rel="manifest" href="/site.webmanifest" />
    <meta name="theme-color" content="#101210" />
    <meta name="generator" content={Astro.generator} />

    <!-- Primary SEO Meta Tags -->
    <title>{title}</title>
    <meta name="title" content={title} />
    <meta name="description" content={description} />
    <meta name="author" content="JOSE JEFFERSON SANTOS (@daylerjeff)" />
    <meta name="keywords" content="Jose Jefferson Santos, JOSE JEFFERSON SANTOS, daylerjeff, daylerjeff199906, JEFF Santos, Jose Jefferson Santos Panaifo, Software Engineer, Ingeniero de Sistemas, Frontend Architecture, Astro, React, TypeScript, josesantos.site, MedMind, Fonoteca IIAP" />
    <meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1" />
    <link rel="canonical" href={canonicalURL} />

    <!-- Language Alternates (hreflang) -->
    <link rel="alternate" hreflang="es" href="https://josesantos.site/" />
    <link rel="alternate" hreflang="en" href="https://josesantos.site/en" />
    <link rel="alternate" hreflang="x-default" href="https://josesantos.site/" />

    <!-- Open Graph / Social Graph -->
    <meta property="og:site_name" content="JOSE JEFFERSON SANTOS (@daylerjeff)" />
    <meta property="og:type" content="profile" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:image" content={ogImageURL} />
    <meta property="og:image:secure_url" content={ogImageURL} />
    <meta property="og:image:type" content="image/png" />
    <meta property="og:image:width" content="1254" />
    <meta property="og:image:height" content="1254" />
    <meta property="og:image:alt" content="JOSE JEFFERSON SANTOS - Software Engineer & Frontend Architect (@daylerjeff)" />
    <meta property="profile:first_name" content="Jose Jefferson" />
    <meta property="profile:last_name" content="Santos Panaifo" />
    <meta property="profile:username" content="daylerjeff" />

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:site" content="@daylerjeff" />
    <meta name="twitter:creator" content="@daylerjeff" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageURL} />

    <!-- Schema.org Structured Data -->
    <script type="application/ld+json" set:html={JSON.stringify(schemaJsonLd)} />

    <!-- Prevent Dark Mode Flicker and persist on page transitions -->
    <script is:inline>
      function applyTheme() {
        const savedTheme = localStorage.getItem("theme");
        const prefersDark = window.matchMedia("(prefers-color-scheme: dark)").matches;
        if (savedTheme === "dark" || (!savedTheme && prefersDark)) {
          document.documentElement.classList.add("dark");
        } else {
          document.documentElement.classList.remove("dark");
        }
      }
      applyTheme();
      document.addEventListener("astro:after-swap", applyTheme);
    </script>

    <!-- Astro View Transitions -->
    <ClientRouter />
  </head>
  <body class="min-h-screen bg-background dark:bg-dark text-ink dark:text-white selection:bg-primary selection:text-ink transition-colors duration-300">
    <Header dict={dict} />

    <main id="main-content" class="overflow-x-hidden">
      <slot />
    </main>

    <!-- Dennis Snellenberg Style Contact & Master Footer -->
    {showContact && dict.contact && (
      <Contact data={dict.contact} site={dict.site} />
    )}

    {showFooter && (
      <Footer data={dict.footer} site={dict.site} />
    )}

    <!-- Animation lifecycle bootstrap -->
    <script>
      import { initAllAnimations } from "../animations";

      // Execute on initial render
      initAllAnimations();
    </script>
  </body>
</html>

---
import type { I18nBridge } from "@platform/types";

interface Props {
  data: I18nBridge;
}

const { data } = Astro.props;
---

<section
  data-story="bridge"
  class="py-24 sm:py-32 container-editorial border-y border-border dark:border-white/10 relative overflow-hidden text-center"
>
  <div class="relative z-10 max-w-3xl mx-auto">
    <p
      data-bridge-text
      class="text-2xl sm:text-3xl md:text-4xl font-sans font-light italic text-ink dark:text-white leading-snug tracking-tight"
    >
      "{data.quote}"
    </p>
  </div>
</section>

---
interface Props {
  size?: "sm" | "md" | "lg";
  variant?: "primary" | "monochrome";
  class?: string;
}

const { size = "md", variant = "primary", class: className = "" } = Astro.props;

const dimensions = {
  sm: "w-7 h-7 sm:w-8 sm:h-8",
  md: "w-8 h-8 sm:w-9 sm:h-9",
  lg: "w-11 h-11"
}[size];
---

<img
  src="/brand/logo-js.svg"
  alt="JS Logo"
  width="32"
  height="32"
  class={`rounded-[6px] object-contain select-none transition-transform duration-200 ${dimensions} ${className}`}
/>

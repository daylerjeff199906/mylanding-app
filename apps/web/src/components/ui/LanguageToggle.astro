---
import type { SupportedLocale } from "@platform/types";
import FlagIcon from "./FlagIcon.astro";

interface Props {
  currentLocale: SupportedLocale;
}

const { currentLocale } = Astro.props;

export interface LanguageOption {
  code: SupportedLocale;
  label: string;
  name: string;
  url: string;
}

// Catálogo extensible de idiomas con soporte para futuras traducciones
const languages: LanguageOption[] = [
  { code: "es", label: "ES", name: "Español", url: "/" },
  { code: "en", label: "EN", name: "English", url: "/en" }
  // Fácilmente extensible en el futuro:
  // { code: "pt", label: "PT", name: "Português", url: "/pt" },
  // { code: "fr", label: "FR", name: "Français", url: "/fr" }
];

const currentLang = languages.find((l) => l.code === currentLocale) || languages[0];
---

<div class="relative inline-block text-left" id="language-select-wrapper">
  <!-- Trigger Button (Styled like a modern editorial custom select) -->
  <button
    id="language-select-btn"
    type="button"
    class="group inline-flex items-center gap-2 px-3 py-1.5 rounded-md bg-white dark:bg-[#1A1D1A] border border-[#D9DDD8] dark:border-[#2E342E] text-xs font-mono font-medium text-[#0B0D0C] dark:text-[#F4F4F5] hover:border-primary dark:hover:border-primary hover:bg-[#F9FAF9] dark:hover:bg-[#222722] focus:outline-none focus:ring-1 focus:ring-primary transition-all duration-200 shadow-xs cursor-pointer select-none"
    aria-expanded="false"
    aria-haspopup="listbox"
    aria-label="Seleccionar idioma / Select language"
  >
    <FlagIcon code={currentLang.code} class="w-4.5 h-3" />
    <span class="font-bold tracking-wider text-[#0B0D0C] dark:text-[#F4F4F5] group-hover:text-primary transition-colors">
      {currentLang.label}
    </span>

    <svg
      id="language-chevron"
      class="w-3.5 h-3.5 text-[#6B706D] dark:text-[#949E97] group-hover:text-primary transition-transform duration-200"
      fill="none"
      viewBox="0 0 24 24"
      stroke="currentColor"
    >
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M19 9l-7 7-7-7" />
    </svg>
  </button>

  <!-- Dropdown Menu (Strictly styled for both Light and Dark mode) -->
  <div
    id="language-select-menu"
    class="hidden absolute right-0 mt-2 w-44 rounded-lg bg-white dark:bg-[#181B18] border border-[#D9DDD8] dark:border-[#2E342E] shadow-xl shadow-black/10 dark:shadow-black/70 py-1.5 z-50 transition-all font-mono text-xs backdrop-blur-md"
    role="listbox"
    aria-label="Opciones de idioma"
  >
    <div class="px-3 py-1 text-[10px] uppercase tracking-wider text-[#6B706D] dark:text-[#808982] font-semibold border-b border-[#D9DDD8]/60 dark:border-[#2E342E]/80 mb-1">
      Idioma / Language
    </div>

    {
      languages.map((lang) => {
        const isSelected = currentLocale === lang.code;

        return (
          <a
            href={lang.url}
            role="option"
            aria-selected={isSelected}
            class={`flex items-center justify-between px-3 py-2 mx-1 rounded-md transition-all duration-150 no-underline cursor-pointer ${
              isSelected
                ? "bg-[#39FF14]/15 dark:bg-[#39FF14]/20 text-[#0B0D0C] dark:text-[#39FF14] font-bold"
                : "text-[#4B524E] dark:text-[#C4CAC5] hover:text-[#0B0D0C] dark:hover:text-white hover:bg-black/5 dark:hover:bg-white/10"
            }`}
          >
            <div class="flex items-center gap-2.5">
              <FlagIcon code={lang.code} class="w-4.5 h-3" />
              <span class="tracking-wide">{lang.name}</span>
            </div>

            <div class="flex items-center gap-1.5">
              <span class="text-[10px] opacity-60 uppercase">{lang.label}</span>
              {isSelected ? (
                <span class="w-1.5 h-1.5 rounded-full bg-primary shadow-[0_0_8px_rgba(57,255,20,0.8)] shrink-0"></span>
              ) : null}
            </div>
          </a>
        );
      })
    }
  </div>
</div>

<script>
  function setupLanguageSelect() {
    const wrapper = document.getElementById("language-select-wrapper");
    const btn = document.getElementById("language-select-btn");
    const menu = document.getElementById("language-select-menu");
    const chevron = document.getElementById("language-chevron");

    if (!wrapper || !btn || !menu || !chevron) return;

    let isOpen = false;

    function toggleMenu(show?: boolean) {
      isOpen = show !== undefined ? show : !isOpen;
      if (isOpen) {
        menu?.classList.remove("hidden");
        btn?.setAttribute("aria-expanded", "true");
        chevron?.classList.add("rotate-180");
      } else {
        menu?.classList.add("hidden");
        btn?.setAttribute("aria-expanded", "false");
        chevron?.classList.remove("rotate-180");
      }
    }

    btn.addEventListener("click", (e) => {
      e.stopPropagation();
      toggleMenu();
    });

    // Close when clicking outside
    document.addEventListener("click", (e) => {
      if (!wrapper.contains(e.target as Node)) {
        toggleMenu(false);
      }
    });

    // Keyboard support (Escape closes menu)
    document.addEventListener("keydown", (e) => {
      if (e.key === "Escape" && isOpen) {
        toggleMenu(false);
        btn.focus();
      }
    });
  }

  setupLanguageSelect();
  document.addEventListener("astro:page-load", setupLanguageSelect);
</script>

---
import type { SupportedLocale } from "@platform/types";

interface Props {
  currentLocale: SupportedLocale;
}

const { currentLocale } = Astro.props;

interface LanguageOption {
  code: SupportedLocale;
  label: string;
  flag: string;
  url: string;
}

const languages: LanguageOption[] = [
  { code: "es", label: "ES · Español", flag: "🇪🇸", url: "/" },
  { code: "en", label: "EN · English", flag: "🇺🇸", url: "/en" }
  // Fácil de extender en el futuro (ej. pt, fr, de)
];
---

<div class="relative inline-flex items-center">
  <label for="language-select" class="sr-only">Seleccionar idioma / Select language</label>
  <div class="relative flex items-center">
    <select
      id="language-select"
      class="appearance-none cursor-pointer pl-2.5 pr-7 py-1.5 rounded-[6px] bg-surface dark:bg-dark border border-border dark:border-white/15 text-xs font-mono font-medium text-ink dark:text-white hover:border-primary focus:border-primary focus:outline-hidden transition-colors shadow-2xs"
      aria-label="Seleccionar idioma"
    >
      {
        languages.map((lang) => (
          <option
            value={lang.url}
            selected={currentLocale === lang.code}
            class="bg-surface dark:bg-dark text-ink dark:text-white py-1"
          >
            {lang.flag} {lang.code.toUpperCase()}
          </option>
        ))
      }
    </select>

    <!-- Custom indicator chevron -->
    <div class="pointer-events-none absolute right-2 flex items-center text-muted">
      <svg class="w-3 h-3" fill="none" viewBox="0 0 24 24" stroke="currentColor">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M19 9l-7 7-7-7" />
      </svg>
    </div>
  </div>
</div>

<script>
  function setupLanguageSelect() {
    const select = document.getElementById("language-select") as HTMLSelectElement | null;
    if (!select) return;

    select.addEventListener("change", (e) => {
      const target = e.target as HTMLSelectElement;
      if (target.value && target.value !== window.location.pathname) {
        window.location.href = target.value;
      }
    });
  }

  setupLanguageSelect();
  document.addEventListener("astro:page-load", setupLanguageSelect);
</script>

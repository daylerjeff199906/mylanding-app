---
interface Props {
  code: string;
  class?: string;
}

const { code, class: className = "w-4.5 h-3.5" } = Astro.props;

// Normalizar código de idioma a código ISO de bandera del paquete flag-icons
const flagMap: Record<string, string> = {
  es: "es", // España
  en: "us", // Inglés -> Estados Unidos
  us: "us",
  gb: "gb",
  fr: "fr",
  de: "de",
  it: "it",
  pt: "pt",
  br: "br",
  pe: "pe",
  mx: "mx",
  co: "co",
  ar: "ar",
  cl: "cl",
};

const countryCode = flagMap[code.toLowerCase()] || code.toLowerCase();
---

<span
  class={`fi fi-${countryCode} rounded-[3px] shadow-xs border border-black/15 dark:border-white/25 inline-block shrink-0 bg-cover bg-center align-middle ${className}`}
  role="img"
  aria-label={`Bandera ${countryCode.toUpperCase()}`}
></span>

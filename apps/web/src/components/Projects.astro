---
import type { I18nProjects } from "@platform/types";
import { joinTokens } from "@platform/utils";

interface Props {
  data: I18nProjects;
}

const { data } = Astro.props;
---

<section
  id="proyectos"
  class="py-32 container-editorial"
>
  <div class="space-y-24">
    <!-- Header -->
    <div class="max-w-3xl space-y-4">
      {data.sectionTag && (
        <div class="flex items-center gap-3">
          <span class="text-xs font-mono tracking-widest text-primary font-bold uppercase">
            // {data.sectionTag}
          </span>
        </div>
      )}

      <h2 class="text-4xl sm:text-5xl md:text-6xl font-display uppercase tracking-tight text-ink dark:text-white leading-[0.95]">
        {data.lead}
      </h2>

      <p class="text-base font-sans text-muted max-w-xl">
        {data.subtitle}
      </p>
    </div>

    <!-- 3 Featured Projects (Alternating text | image) -->
    <div class="space-y-28 sm:space-y-36">
      {
        data.items.map((project, index) => {
          const isReversed = index % 2 === 1;

          return (
            <article
              id={project.id}
              data-project-item
              class="relative pt-12 border-t border-border dark:border-white/10"
            >
              <div class={`grid grid-cols-1 lg:grid-cols-12 gap-10 lg:gap-16 items-center ${isReversed ? "lg:flex-row-reverse" : ""}`}>
                <!-- Editorial Content Column -->
                <div class={`lg:col-span-5 space-y-6 ${isReversed ? "lg:order-2" : "lg:order-1"}`}>
                  <div class="flex items-baseline gap-3">
                    <span
                      data-part="number"
                      class="text-xs font-mono font-bold tracking-widest text-primary bg-ink px-2 py-0.5 rounded-[4px]"
                    >
                      {project.number}
                    </span>
                    <span class="text-xs font-mono text-muted uppercase font-medium">
                      / {project.tagline}
                    </span>
                  </div>

                  <h3
                    data-part="title"
                    class="text-4xl sm:text-5xl font-display uppercase tracking-tight text-ink dark:text-white leading-none"
                  >
                    {project.title}
                  </h3>

                  <p
                    data-part="desc"
                    class="text-sm sm:text-base font-sans text-ink/80 dark:text-white/80 leading-relaxed"
                  >
                    {project.description}
                  </p>

                  <!-- Role meta with explicit attribution guidelines -->
                  <div data-part="meta" class="pt-4 border-t border-border dark:border-white/10 space-y-1">
                    <span class="text-xs font-mono text-muted uppercase tracking-wider block">
                      {data.roleLabel}
                    </span>
                    <p class="text-sm font-sans font-semibold text-ink dark:text-white">
                      {joinTokens(project.role, " · ")}
                    </p>
                  </div>

                  <!-- Tags -->
                  <div class="flex flex-wrap gap-2 pt-2">
                    {project.tags.map((tag) => (
                      <span class="px-2.5 py-1 text-[11px] font-mono rounded-sm bg-surface dark:bg-white/5 text-muted border border-border dark:border-white/10">
                        {tag}
                      </span>
                    ))}
                  </div>

                  <!-- Editorial link with expanding arrow -->
                  <div class="pt-4">
                    <a href={project.link || "#"} class="editorial-link">
                      <span>{data.ctaCase}</span>
                      <span class="arrow font-sans">→</span>
                    </a>
                  </div>
                </div>

                <!-- Editorial Image Column with geometric radius -->
                <div class={`lg:col-span-7 ${isReversed ? "lg:order-1" : "lg:order-2"}`}>
                  <div
                    data-part="image"
                    class="group relative overflow-hidden rounded-md bg-surface dark:bg-dark border border-border dark:border-white/10 shadow-xs"
                  >
                    <img
                      src={project.image.src}
                      alt={project.image.alt}
                      class="w-full h-auto object-cover transition-transform duration-700 ease-out group-hover:scale-[1.015]"
                      loading="lazy"
                    />
                  </div>
                </div>
              </div>
            </article>
          );
        })
      }
    </div>

    <!-- Discreet View More Projects CTA -->
    <div class="pt-6 text-center">
      <a href="#soluciones" class="btn-primary">
        <span>{data.ctaViewMore}</span>
        <span>→</span>
      </a>
    </div>
  </div>
</section>

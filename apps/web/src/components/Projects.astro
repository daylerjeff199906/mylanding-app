---
import type { I18nProjects } from "@platform/types";

interface Props {
  data: I18nProjects;
}

const { data } = Astro.props;
const isEn = Astro.url.pathname.startsWith("/en");
const worksHref = isEn ? "/en/work" : "/proyectos";

// Show featured or top 4 projects on home, with total count for the pill
const displayedProjects = data.items.slice(0, 4);
const totalCount = data.allProjects ? data.allProjects.length : 11;
---

<section
  id="proyectos"
  class="py-24 sm:py-32 container-editorial"
>
  <div class="space-y-16 sm:space-y-20">
    <!-- Header -->
    <div class="max-w-3xl space-y-4">
      {data.sectionTag && (
        <div class="flex items-center gap-3">
          <span class="text-xs font-mono tracking-widest text-primary font-bold uppercase">
            // {data.sectionTag}
          </span>
        </div>
      )}

      <h2 class="text-4xl sm:text-5xl md:text-6xl font-display uppercase tracking-tight text-ink dark:text-white leading-[0.95]">
        {data.lead}
      </h2>

      <p class="text-sm sm:text-base font-sans text-muted max-w-xl">
        {data.subtitle}
      </p>
    </div>

    <!-- Editorial Minimalist Works List (Dennis Snellenberg Style - Pure Typography) -->
    <div class="border-b border-border dark:border-white/10">
      {
        displayedProjects.map((project, index) => {
          const discipline =
            project.discipline ||
            (Array.isArray(project.role) ? project.role.join(" & ") : project.tagline);

          return (
            <a
              href={`${worksHref}#${project.id}`}
              class="group block relative py-10 sm:py-14 md:py-16 border-t border-border dark:border-white/10 transition-all duration-300 no-underline cursor-pointer"
            >
              <div class="flex flex-col md:flex-row md:items-baseline justify-between gap-3 sm:gap-6">
                <!-- Left Column: Title with smooth translation -->
                <div class="flex items-baseline gap-4 sm:gap-6">
                  <h3 class="text-3xl sm:text-5xl md:text-6xl lg:text-7xl font-sans font-medium tracking-tight text-ink dark:text-white group-hover:translate-x-3 sm:group-hover:translate-x-4 transition-transform duration-300 ease-out">
                    {project.title}
                  </h3>
                </div>

                <!-- Right Column: Discipline / Category -->
                <div class="flex items-center gap-3 md:text-right">
                  <span class="text-xs sm:text-sm font-sans tracking-normal text-muted group-hover:text-ink dark:group-hover:text-white transition-colors duration-300">
                    {discipline}
                  </span>
                  <span class="text-xs font-mono text-muted/60 opacity-0 group-hover:opacity-100 group-hover:translate-x-1 transition-all duration-300 hidden sm:inline">
                    ↗
                  </span>
                </div>
              </div>
            </a>
          );
        })
      }
    </div>

    <!-- Centered Pill Button: "More work ¹¹" / "Más proyectos ¹¹" (Dennis Snellenberg Style) -->
    <div class="pt-8 sm:pt-14 flex justify-center">
      <a
        href={worksHref}
        class="group inline-flex items-center gap-1.5 px-9 py-4 rounded-full border border-border dark:border-white/20 text-sm font-sans font-normal text-ink dark:text-white hover:border-ink dark:hover:border-white hover:bg-ink hover:text-white dark:hover:bg-white dark:hover:text-black transition-all duration-300 shadow-xs active:scale-95 no-underline"
      >
        <span>{data.moreWorkLabel || (isEn ? "More work" : "Más proyectos")}</span>
        <sup class="text-[11px] font-mono font-medium -top-1.5 text-muted group-hover:text-primary dark:group-hover:text-black transition-colors">
          {totalCount}
        </sup>
      </a>
    </div>
  </div>
</section>

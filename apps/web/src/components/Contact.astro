---
import type { I18nContact, I18nSiteInfo } from "@platform/types";
import { ArrowDownLeft, ArrowUpRight, ArrowUp } from "lucide-astro";

interface Props {
  data: I18nContact;
  site: I18nSiteInfo;
}

const { data, site } = Astro.props;
const isEn = Astro.url.pathname.startsWith("/en");

const headingLine1 = data.headingLine1 || (isEn ? "Let's work" : "Trabajemos");
const headingLine2 = data.headingLine2 || (isEn ? "together" : "juntos");
const ctaButton = data.ctaButton || (isEn ? "Get in touch" : "Hablemos");
const email = data.email || "daylersan@gmail.com";
const phone = data.phone || "+51 966 870 897";
const location = data.location || (isEn ? "Lima, Peru" : "Lima, Perú");
const contactUrl = isEn ? "/en/contact" : "/contacto";
const cleanPhone = phone.replace(/[^\d+]/g, "");
const waNumber = cleanPhone.replace("+", "");
---

<section
  id="contacto"
  class="relative bg-[#141517] text-white pt-24 pb-16 sm:pt-32 sm:pb-20 overflow-hidden"
>
  <div class="container-editorial space-y-12 sm:space-y-16">
    <!-- Top Header: Avatar + Headline + Arrow (Dennis Snellenberg Style) -->
    <div class="flex flex-col lg:flex-row lg:items-center justify-between gap-8">
      <div class="flex items-center gap-6 sm:gap-8">
        <!-- Author Profile Avatar with availability status ring -->
        <div class="relative shrink-0">
          <img
            src="/images/me.png"
            alt={site.fullName}
            width="80"
            height="80"
            class="w-16 h-16 sm:w-20 sm:h-20 rounded-full object-cover border border-white/20 shadow-lg grayscale hover:grayscale-0 transition-all duration-300"
          />
          <span
            class="absolute bottom-0 right-0 w-4 h-4 rounded-full bg-[#39FF14] border-2 border-[#141517]"
            title={data.availability || "Disponible para proyectos"}
          ></span>
        </div>

        <!-- Huge Headline: "Let's work together" -->
        <h2 class="text-5xl sm:text-7xl md:text-8xl lg:text-9xl font-display uppercase tracking-tight text-white leading-[0.88]">
          <span class="block">{headingLine1}</span>
          <span class="block">{headingLine2}</span>
        </h2>
      </div>

      <!-- Arrow Icon -->
      <div class="hidden lg:block self-start pt-4 pr-4">
        <ArrowDownLeft class="w-10 h-10 sm:w-12 sm:h-12 text-white/40 block transform hover:translate-x-1 hover:translate-y-1 transition-transform" />
      </div>
    </div>

    <!-- Divider Line with Circular Floating Primary Green Action Button -->
    <div class="relative pt-6 sm:pt-10">
      <!-- Thin Divider -->
      <div class="border-t border-white/10 w-full"></div>

      <!-- Signature Floating Circular Button in Vibrant Primary Green (#39FF14) linking to routable contact page -->
      <div class="flex justify-start sm:justify-end -mt-16 sm:-mt-20 pr-4 sm:pr-10 relative z-20">
        <a
          href={contactUrl}
          class="w-36 h-36 sm:w-44 sm:h-44 md:w-48 md:h-48 rounded-full bg-[#39FF14] hover:bg-[#32e012] text-black font-semibold flex items-center justify-center text-center font-sans text-base sm:text-xl shadow-[0_0_60px_rgba(57,255,20,0.35)] transition-all duration-300 hover:scale-105 active:scale-95 no-underline cursor-pointer group"
          id="get-in-touch-btn"
          aria-label={isEn ? "Go to contact page" : "Ir a la página de contacto"}
        >
          <span class="group-hover:scale-105 transition-transform tracking-tight">
            {ctaButton}
          </span>
        </a>
      </div>
    </div>

    <!-- Contact Direct Pills (Email, WhatsApp, Phone & Link to Page) -->
    <div class="flex flex-wrap items-center gap-3 sm:gap-5 pt-2">
      <!-- Routable Form Button Pill -->
      <a
        href={contactUrl}
        class="inline-flex items-center gap-2.5 px-6 py-3 rounded-full bg-[#39FF14] text-black font-medium hover:bg-[#32e012] transition-all duration-300 text-xs sm:text-sm font-sans no-underline cursor-pointer group shadow-sm hover:scale-102"
      >
        <span>{isEn ? "Open message form" : "Abrir formulario"}</span>
        <ArrowUpRight class="w-3.5 h-3.5 group-hover:translate-x-0.5 group-hover:-translate-y-0.5 transition-transform" />
      </a>

      <!-- Email Pill -->
      <a
        href={`mailto:${email}`}
        class="contact-pill inline-flex items-center gap-2.5 px-6 py-3 rounded-full border border-white/15 bg-white/5 hover:bg-white hover:text-black transition-all duration-300 text-xs sm:text-sm font-sans text-white/90 no-underline cursor-pointer group"
        title={isEn ? "Send email" : "Enviar correo"}
      >
        <span class="font-mono text-xs text-[#39FF14] group-hover:text-black">@</span>
        <span>{email}</span>
      </a>

      <!-- WhatsApp Pill -->
      <a
        href={`https://wa.me/${waNumber}?text=${encodeURIComponent(isEn ? "Hello Jeff, I'm reaching out through your official site josesantos.site." : "Hola Jeff, te escribo desde tu sitio web josesantos.site.")}`}
        target="_blank"
        rel="noopener noreferrer"
        class="contact-pill inline-flex items-center gap-2.5 px-6 py-3 rounded-full border border-white/15 bg-white/5 hover:bg-[#25D366] hover:text-black hover:border-[#25D366] transition-all duration-300 text-xs sm:text-sm font-sans text-white/90 no-underline cursor-pointer group"
        title="WhatsApp"
      >
        <span class="font-mono text-xs text-[#39FF14] group-hover:text-black">WA</span>
        <span>{phone}</span>
      </a>

      <!-- Availability Badge -->
      <span class="text-xs font-mono text-white/40 hidden md:inline-block ml-auto">
        // {data.availability || (isEn ? "Available for selected projects & consulting" : "Disponible para proyectos & consultoría")}
      </span>
    </div>

    <!-- Bottom Meta & Live Clock -->
    <div class="pt-16 sm:pt-20 border-t border-white/10 flex flex-col sm:flex-row items-center justify-between gap-6 text-xs font-mono text-white/50">
      <div class="flex items-center gap-3">
        <span class="w-2 h-2 rounded-full bg-[#39FF14]"></span>
        <span>{location}</span>
        <span>·</span>
        <span id="local-clock" data-base-time="17:48">17:48 COT (UTC-5)</span>
      </div>

      <div class="flex flex-wrap gap-6 text-white/70">
        <a
          href="https://www.linkedin.com/in/josé-jefferson-santos-panaifo-3668a7246"
          target="_blank"
          rel="noopener noreferrer"
          class="hover:text-white transition-colors inline-flex items-center gap-1"
        >
          <span>LinkedIn</span>
          <ArrowUpRight class="w-3 h-3" />
        </a>
        <a
          href="https://github.com"
          target="_blank"
          rel="noopener noreferrer"
          class="hover:text-white transition-colors inline-flex items-center gap-1"
        >
          <span>GitHub</span>
          <ArrowUpRight class="w-3 h-3" />
        </a>
        <a
          href="https://www.tiktok.com/@daylerjeff"
          target="_blank"
          rel="noopener noreferrer"
          class="hover:text-white transition-colors inline-flex items-center gap-1"
        >
          <span>TikTok</span>
          <ArrowUpRight class="w-3 h-3" />
        </a>
        <a
          href="#main-content"
          class="hover:text-white transition-colors ml-2 inline-flex items-center gap-1"
        >
          <ArrowUp class="w-3 h-3" />
          <span>{isEn ? "Back to top" : "Volver arriba"}</span>
        </a>
      </div>

      <p class="text-white/40">
        © {new Date().getFullYear()} {site.brandName}.
      </p>
    </div>
  </div>
</section>

<!-- Scripts: Live Clock -->
<script>
  function updateClock() {
    const clockEl = document.getElementById("local-clock");
    if (!clockEl) return;

    try {
      const now = new Date();
      const timeStr = now.toLocaleTimeString("es-PE", {
        timeZone: "America/Lima",
        hour: "2-digit",
        minute: "2-digit",
        hour12: false
      });
      clockEl.textContent = `${timeStr} COT (UTC-5)`;
    } catch {
      // Fallback
    }
  }

  updateClock();
  setInterval(updateClock, 30000);

  document.addEventListener("astro:page-load", updateClock);
</script>

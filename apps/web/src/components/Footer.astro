---
import type { I18nFooter, I18nSiteInfo } from "@platform/types";
import MonogramJS from "./ui/MonogramJS.astro";
import { ArrowUp, ArrowUpRight, ArrowRight } from "lucide-astro";

interface Props {
  data: I18nFooter;
  site: I18nSiteInfo;
}

const { data, site } = Astro.props;
const isEn = Astro.url.pathname.startsWith("/en");
const contactUrl = isEn ? "/en/contact" : "/contacto";
---

<footer class="py-20 border-t border-border dark:border-white/10 bg-black/5 dark:bg-black/30">
  <div class="container-editorial space-y-12">
    <div class="flex flex-col md:flex-row md:items-baseline justify-between gap-8">
      <div class="space-y-3 max-w-md">
        <div class="flex items-center gap-3">
          <MonogramJS size="sm" />
          <span class="font-display text-2xl uppercase tracking-tight text-ink dark:text-white">
            {site.brandName}
          </span>
        </div>
        <p class="text-xs sm:text-sm font-sans text-muted leading-relaxed">
          {data.brandStatement}
        </p>
      </div>

      <div class="flex flex-wrap gap-8 text-xs font-mono font-medium text-muted">
        <a href="#hero" class="editorial-link inline-flex items-center gap-1.5">
          <span>{data.backToTop}</span>
          <ArrowUp class="w-3.5 h-3.5" />
        </a>
        <a href="https://github.com" target="_blank" rel="noopener noreferrer" class="editorial-link inline-flex items-center gap-1.5">
          <span>{data.github}</span>
          <ArrowUpRight class="w-3.5 h-3.5" />
        </a>
        <a href={contactUrl} class="editorial-link inline-flex items-center gap-1.5">
          <span>{data.contact}</span>
          <ArrowRight class="w-3.5 h-3.5" />
        </a>
      </div>
    </div>

    <div class="pt-8 border-t border-border dark:border-white/10 flex flex-col sm:flex-row items-center justify-between gap-4 text-xs font-mono text-muted">
      <p class="font-medium text-ink dark:text-white">
        "{data.philosophyQuote}"
      </p>
      <p>
        © {new Date().getFullYear()} {site.brandName} · {data.rights}
      </p>
    </div>
  </div>
</footer>

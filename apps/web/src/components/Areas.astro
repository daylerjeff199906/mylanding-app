---
import type { I18nAreas } from "@platform/types";

interface Props {
  data: I18nAreas;
}

const { data } = Astro.props;

const fullName = data.fullName || "Soy José Jefferson Santos";
const degree = data.degree || "Egresado de Ingeniería de Sistemas e Informática";
const statementLead = data.statementLead || (data.lead ?? "");
const statementBody = data.statementBody || (data.subtitle ?? "");
const statementImpact = data.statementImpact || "";
---

<section
  id="contexto"
  data-story="areas"
  class="py-24 sm:py-32 container-editorial select-text border-t border-border/70 dark:border-white/10"
>
  <div class="space-y-12 sm:space-y-16">
    <!-- Encabezado de Alto Impacto (Inspirado en la tipografía masiva HI, I'M JOE) -->
    <div class="space-y-4 max-w-5xl">
      <h2
        data-areas-lead
        class="text-5xl sm:text-6xl md:text-7xl lg:text-8xl xl:text-[6.25rem] font-display uppercase tracking-tight text-ink dark:text-[#FAF7EE] leading-[0.92]"
      >
        {fullName}
      </h2>

      <p
        data-area-item
        class="font-mono text-xs sm:text-sm uppercase tracking-widest text-primary font-bold pt-1"
      >
        // {degree}
      </p>
    </div>

    <!-- Composición Editorial de Lectura (Inspirada en el layout de bio editorial Anton Repponen) -->
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 lg:gap-16 pt-8 border-t border-border/60 dark:border-white/10">
      <!-- Columna izquierda: Contexto & Enfoque -->
      <div class="lg:col-span-4 space-y-6">
        <div data-area-item class="space-y-2">
          <span class="font-mono text-xs font-semibold uppercase tracking-widest text-muted dark:text-[#949E97]">
            Enfoque
          </span>
          <p class="font-sans text-sm sm:text-base text-ink dark:text-white font-medium leading-relaxed">
            Arquitectura de Software · UX & Frontend · Optimización de Procesos
          </p>
        </div>

        <div data-area-item class="space-y-2">
          <span class="font-mono text-xs font-semibold uppercase tracking-widest text-muted dark:text-[#949E97]">
            Sectores de Participación
          </span>
          <p class="font-sans text-sm sm:text-base text-muted dark:text-[#949E97] leading-relaxed">
            Educación · Salud · Gestión institucional · Productos digitales · Impacto ambiental
          </p>
        </div>
      </div>

      <!-- Columna derecha: Narrativa personal en tipografía editorial fluida -->
      <div class="lg:col-span-8 space-y-6 sm:space-y-8">
        {statementLead && (
          <p
            data-area-item
            class="text-xl sm:text-2xl md:text-[1.625rem] font-sans font-medium text-ink dark:text-white leading-[1.38] tracking-tight"
          >
            {statementLead}
          </p>
        )}

        {statementBody && (
          <p
            data-area-item
            class="text-base sm:text-lg font-sans text-muted dark:text-[#949E97] leading-relaxed"
          >
            {statementBody}
          </p>
        )}

        {statementImpact && (
          <p
            data-area-item
            class="text-base sm:text-lg font-sans text-ink/90 dark:text-white/90 leading-relaxed pl-5 border-l-2 border-primary"
          >
            {statementImpact}
          </p>
        )}
      </div>
    </div>
  </div>
</section>

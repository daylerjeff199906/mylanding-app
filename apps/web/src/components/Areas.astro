---
import type { I18nAreas } from "@platform/types";
import { ArrowUpRight } from "lucide-astro";

interface Props {
  data: I18nAreas;
}

const { data } = Astro.props;

const titlePrefix = data.titlePrefix || "Soy";
const titleName = data.titleName || "JOSÉ JEFFERSON SANTOS";
const statementLead = data.statementLead || (data.lead ?? "");
const dedicationTitle = data.dedicationTitle || "A lo que me dedico";
const dedicationText = data.dedicationText || "Desarrollo de software, experiencia de usuario (UX), arquitectura frontend, implementación de funcionalidades y optimización de procesos.";
const areasTitle = data.areasTitle || "Áreas en las que participo";
const areasList = data.areasList || "Educación · Salud · Datos · Gestión institucional · Productos digitales · Impacto ambiental";
const statementImpact = data.statementImpact || "";
const imageSrc = data.imageSrc || "/images/me.png";
const imageAlt = data.imageAlt || "José Jefferson Santos";
const bgCircleSrc = "/images/circulo_verde_39FF14.svg";

// Helper para renderizar texto con markdown **negrita**
const renderFormatted = (text: string) => {
  return text.replace(/\*\*(.*?)\*\*/g, '<strong class="font-semibold text-ink dark:text-white">$1</strong>');
};

const socialLinks = [
  {
    name: "LinkedIn",
    url: "https://www.linkedin.com/in/josé-jefferson-santos-panaifo-3668a7246",
    handle: "in/josé-jefferson-santos",
    icon: "linkedin"
  },
  {
    name: "Facebook",
    url: "https://www.facebook.com/profile.php?id=61578866186269",
    handle: "fb/jeff.santos",
    icon: "facebook"
  },
  {
    name: "TikTok",
    url: "https://www.tiktok.com/@daylerjeff",
    handle: "@daylerjeff",
    icon: "tiktok"
  }
];
---

<section
  id="contexto"
  data-story="areas"
  class="relative py-24 sm:py-32 container-editorial select-text border-t border-border/70 dark:border-white/10 overflow-hidden"
>
  <!-- Textura editorial técnica de fondo (rejilla milimétrica y retícula sutil) -->
  <div class="absolute inset-0 pointer-events-none opacity-[0.03] dark:opacity-[0.05] select-none" style="background-image: linear-gradient(to right, currentColor 1px, transparent 1px), linear-gradient(to bottom, currentColor 1px, transparent 1px); background-size: 40px 40px;"></div>
  
  <!-- Resplandor ambiental de profundidad en esquinas -->
  <div class="absolute -top-32 right-10 w-96 h-96 bg-primary/10 rounded-full blur-3xl pointer-events-none -z-10"></div>
  <div class="absolute -bottom-32 left-10 w-96 h-96 bg-primary/5 rounded-full blur-3xl pointer-events-none -z-10"></div>

  <div class="relative grid grid-cols-1 lg:grid-cols-12 gap-12 lg:gap-16 items-start">
    <!-- Columna izquierda: Título en 2 líneas y contenido editorial fluido -->
    <div class="lg:col-span-7 xl:col-span-7 space-y-10 sm:space-y-12">
      <!-- Título de Alto Impacto: "Soy" en fuente normal y grande, nombre en tipografía display -->
      <div class="space-y-1 sm:space-y-2">
        <span class="font-sans font-normal text-2xl sm:text-3xl md:text-4xl lg:text-[2.75rem] text-muted dark:text-[#949E97] tracking-tight block">
          {titlePrefix}
        </span>
        <h2
          data-areas-lead
          class="text-5xl sm:text-6xl md:text-7xl lg:text-8xl xl:text-[6.75rem] font-display uppercase tracking-tight text-ink dark:text-[#FAF7EE] leading-[0.92]"
        >
          {titleName}
        </h2>
      </div>

      <!-- Párrafos narrativos continuos y estructuración de áreas -->
      <div class="space-y-8 sm:space-y-10 max-w-2xl">
        {statementLead && (
          <p
            data-area-item
            class="text-lg sm:text-xl md:text-[1.325rem] font-sans font-normal text-ink/90 dark:text-[#E2DFD2] leading-[1.48] tracking-tight"
            set:html={renderFormatted(statementLead)}
          />
        )}

        <!-- A lo que me dedico y Áreas en las que participo -->
        <div data-area-item class="grid grid-cols-1 sm:grid-cols-2 gap-8 pt-6 border-t border-border/60 dark:border-white/10">
          <div class="space-y-2">
            <span class="font-mono text-xs font-semibold uppercase tracking-widest text-primary block">
              // {dedicationTitle}
            </span>
            <p class="font-sans text-sm sm:text-base text-ink dark:text-white leading-relaxed font-medium">
              {dedicationText}
            </p>
          </div>

          <div class="space-y-2">
            <span class="font-mono text-xs font-semibold uppercase tracking-widest text-muted dark:text-[#949E97] block">
              // {areasTitle}
            </span>
            <p class="font-sans text-sm sm:text-base text-muted dark:text-[#949E97] leading-relaxed">
              {areasList}
            </p>
          </div>
        </div>

        {statementImpact && (
          <p
            data-area-item
            class="text-base sm:text-lg font-sans text-ink/90 dark:text-white/90 leading-relaxed pl-5 border-l-2 border-primary"
          >
            {statementImpact}
          </p>
        )}
      </div>
    </div>

    <!-- Columna derecha: Círculo verde #39FF14 de fondo con me.png recortado abajo y sobresaliendo arriba, efecto B/N a Color solo en la foto y redes sociales -->
    <div
      data-area-item
      class="lg:col-span-5 xl:col-span-5 w-full flex flex-col items-center lg:items-end lg:sticky lg:top-24 gap-6"
    >
      <div class="relative w-full max-w-[340px] sm:max-w-[380px] lg:max-w-[400px] h-[380px] sm:h-[420px] flex items-end justify-center select-none group">
        
        <!-- Círculo verde #39FF14 de fondo plano y nítido (sin reflejos ni brillos artificiales) -->
        <div class="absolute bottom-0 w-[300px] h-[300px] sm:w-[340px] sm:h-[340px] lg:w-[350px] lg:h-[350px] rounded-full overflow-hidden">
          <img
            src={bgCircleSrc}
            alt=""
            aria-hidden="true"
            class="w-full h-full object-cover"
          />
        </div>

        <!-- Foto de perfil (me.png): Sobresale por arriba del círculo, y en la mitad inferior queda contenida en la curvatura circular -->
        <div 
          class="relative z-10 w-full h-full flex items-end justify-center pointer-events-none"
          style="clip-path: polygon(0% 0%, 100% 0%, 100% calc(100% - 175px), 0% calc(100% - 175px));"
        >
          <!-- Capa A: Mitad superior que sobresale libremente -->
          <img
            src={imageSrc}
            alt={imageAlt}
            width="800"
            height="800"
            loading="eager"
            class="w-[84%] sm:w-[82%] h-auto object-contain object-bottom drop-shadow-[0_16px_30px_rgba(0,0,0,0.25)] dark:drop-shadow-[0_20px_40px_rgba(0,0,0,0.65)] grayscale contrast-[1.06] brightness-[0.98] group-hover:grayscale-0 group-hover:contrast-100 group-hover:brightness-100 transition-all duration-700 ease-out"
          />
        </div>

        <!-- Capa B: Mitad inferior que se recorta exactamente dentro del círculo verde -->
        <div class="absolute bottom-0 w-[300px] h-[300px] sm:w-[340px] sm:h-[340px] lg:w-[350px] lg:h-[350px] rounded-full overflow-hidden pointer-events-none z-10">
          <img
            src={imageSrc}
            alt=""
            aria-hidden="true"
            width="800"
            height="800"
            loading="eager"
            class="absolute bottom-0 left-1/2 -translate-x-1/2 w-[95%] sm:w-[94%] max-w-none h-auto object-contain object-bottom grayscale contrast-[1.06] brightness-[0.98] group-hover:grayscale-0 group-hover:contrast-100 group-hover:brightness-100 transition-all duration-700 ease-out"
          />
        </div>

      </div>

      <!-- Links a Redes Sociales debajo de la foto de perfil (sin el texto // Conectar & Redes) -->
      <div class="w-full max-w-[340px] sm:max-w-[380px] lg:max-w-[400px] pt-4 border-t border-border/70 dark:border-white/10 flex items-center justify-center lg:justify-start gap-3">
        {socialLinks.map((item) => (
          <a
            href={item.url}
            target="_blank"
            rel="noopener noreferrer"
            class="group flex items-center gap-2 px-3.5 py-2 rounded-lg bg-surface/80 dark:bg-[#151815]/90 border border-border/80 dark:border-white/10 hover:border-primary/60 dark:hover:border-primary/50 text-ink dark:text-white transition-all duration-300 shadow-sm hover:shadow-md hover:-translate-y-0.5"
            aria-label={item.name}
          >
            {item.icon === "linkedin" && (
              <svg class="w-4 h-4 text-muted dark:text-[#949E97] group-hover:text-primary transition-colors fill-current" viewBox="0 0 24 24">
                <path d="M19 3a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h14m-.5 15.5v-5.3a3.26 3.26 0 0 0-3.26-3.26c-.85 0-1.84.52-2.28 1.3v-1.11h-2.79v8.37h2.79v-4.93c0-.77.62-1.4 1.39-1.4a1.4 1.4 0 0 1 1.4 1.4v4.93h2.75M6.46 10.9v8.37H9.2V10.9H6.46M7.83 6.64a1.67 1.67 0 1 0 0 3.34 1.67 1.67 0 0 0 0-3.34Z"/>
              </svg>
            )}
            {item.icon === "facebook" && (
              <svg class="w-4 h-4 text-muted dark:text-[#949E97] group-hover:text-primary transition-colors fill-current" viewBox="0 0 24 24">
                <path d="M22 12c0-5.52-4.48-10-10-10S2 6.48 2 12c0 4.84 3.44 8.87 8 9.8V15H8v-3h2V9.5C10 7.57 11.57 6 13.5 6H16v3h-2c-.55 0-1 .45-1 1v2h3v3h-3v6.95C18.05 21.45 22 17.19 22 12Z"/>
              </svg>
            )}
            {item.icon === "tiktok" && (
              <svg class="w-4 h-4 text-muted dark:text-[#949E97] group-hover:text-primary transition-colors fill-current" viewBox="0 0 24 24">
                <path d="M16.6 5.82s.51.5 0 0A4.278 4.278 0 0 1 15.54 3h-3.09v12.4a2.592 2.592 0 0 1-2.59 2.5 2.592 2.592 0 0 1-2.59-2.5 2.592 2.592 0 0 1 2.59-2.5c.34 0 .66.06.96.16V9.92a5.674 5.674 0 0 0-.96-.08A5.69 5.69 0 0 0 4.16 15.5a5.69 5.69 0 0 0 5.69 5.66 5.69 5.69 0 0 0 5.69-5.66V9.17a7.28 7.28 0 0 0 4.3 1.4V7.47a4.24 4.24 0 0 1-3.24-1.65Z"/>
              </svg>
            )}
            <span class="font-sans text-xs font-medium tracking-tight text-ink/80 dark:text-white/80 group-hover:text-primary transition-colors">
              {item.name}
            </span>
            <ArrowUpRight class="w-3.5 h-3.5 text-muted dark:text-[#949E97] group-hover:text-primary group-hover:translate-x-0.5 group-hover:-translate-y-0.5 transition-all" />
          </a>
        ))}
      </div>

    </div>
  </div>
</section>

